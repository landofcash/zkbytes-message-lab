{
  "name": "zkbytes-message-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src *.json *.ts *.js index.html README.md",
    "test": "vitest run"
  },
  "dependencies": {
    "@metamask/connect-evm": "2.1.1",
    "@radix-ui/react-slot": "1.3.3",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "@zkbytes/sdk": "0.1.4",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
